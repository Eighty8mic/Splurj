ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2

GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

YOUTUBE_CLIENT_SECRET=./client_secret.json
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=27

AMBIENT_DB=-9
SHORT_MIN_SEGMENTS=3
SHORT_MAX_SEGMENTS=4

# Optional: email alert when the nightly run finds a dead YouTube OAuth token.
# A desktop toast notification always fires too, no config needed for that.
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
